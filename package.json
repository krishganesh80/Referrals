{
  "name": "referral-support",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "scripts": {
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "verify": "pnpm typecheck && pnpm test",
    "ingest": "tsx packages/ingest/src/cli/run.ts",
    "access:verify": "tsx packages/access/src/cli/verify.ts",
    "e2e": "pnpm --filter @referral/web exec playwright test"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "fast-check": "^4.9.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^3.0.5"
  }
}
